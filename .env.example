# Prodlysis configuration
# Copy this file to .env and fill in the values you want.

# Secret key for Flask sessions (generate one: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# --- AI Provider (optional) ----------------------------------------------
# If you set one of these keys, Prodlysis will use the real model to write
# richer narratives. If unset, the built-in deterministic engine is used.
# DeepSeek uses an OpenAI-compatible API (deepseek-chat / deepseek-reasoner).
AI_PROVIDER=deepseek   # "openai" | "anthropic" | "deepseek" | "none"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional: model override for DeepSeek (default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat
